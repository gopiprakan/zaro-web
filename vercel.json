{
  "version": 2,
  "buildCommand": "npm run build",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/portal/assets/(.*)",
      "destination": "/portal/dist/assets/$1"
    },
    {
      "source": "/portal/(.*)",
      "destination": "/portal/dist/index.html"
    },
    {
      "source": "/portal",
      "destination": "/portal/dist/index.html"
    },
    {
      "source": "/login/(.*)",
      "destination": "/login/$1"
    },
    {
      "source": "/login",
      "destination": "/login/index.html"
    }
  ]
}
