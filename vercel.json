{
  "version": 2,
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "functions": {
    "api/index.js": {
      "includeFiles": "backend/data/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/portal/assets/(.*)",
      "destination": "/portal/dist/assets/$1"
    },
    {
      "source": "/portal/(.*)",
      "destination": "/portal/dist/index.html"
    },
    {
      "source": "/portal",
      "destination": "/portal/dist/index.html"
    },
    {
      "source": "/login/(.*)",
      "destination": "/login/$1"
    },
    {
      "source": "/login",
      "destination": "/login/index.html"
    }
  ]
}

